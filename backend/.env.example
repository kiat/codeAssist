DB_CONNECTION_STRING=
SECRET_KEY=
API_SECRET_KEY=
PASSWORD_SALT=
FRONTEND_ORIGIN=http://localhost:3000

# Gemini over Vertex AI
# Standard Vertex AI uses Application Default Credentials plus project/location.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI Express Mode uses an API key from the server environment.
# Leave VERTEX_AI_AUTH_MODE unset for ADC mode.
# If GOOGLE_CLOUD_PROJECT is set in API-key mode, CodeAssist also passes
# GOOGLE_CLOUD_LOCATION to Vertex AI.
# VERTEX_AI_AUTH_MODE=api_key
VERTEX_AI_API_KEY=
